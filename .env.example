# Flask
SECRET_KEY=change-this-to-a-random-secret
ADMIN_PASSWORD=change-this-admin-password

# Hugging Face Space base URL
HF_API_URL=https://your-private-space.hf.space
HF_API_TOKEN=your-hf-token

# Backward-compatible aliases also supported by the code
# HF_SPACE_URL=https://your-private-space.hf.space
# HF_TOKEN=your-hf-token

# Keepalive
ENABLE_KEEPALIVE=true
RENDER_URL=https://your-render-service.onrender.com
HF_PING_INTERVAL_SECONDS=720
RENDER_PING_INTERVAL_SECONDS=720
KEEPALIVE_TIMEOUT_SECONDS=10

# Weather
OWM_API_KEY=your-openweathermap-api-key

# Turso
TURSO_URL=libsql://your-database.turso.io
TURSO_TOKEN=your-turso-token
