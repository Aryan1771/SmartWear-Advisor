# .env.example — copy to .env for local dev, set as env vars on Render

# Flask
SECRET_KEY=change-this-to-a-random-secret-string

# Admin login
ADMIN_PASSWORD=your-secure-admin-password

# HuggingFace Space URL (your ML inference server)
HF_SPACE_URL=https://your-username-smartwear.hf.space

# OpenWeatherMap API key (free tier — weather + UV + AQI)
OWM_API_KEY=your-openweathermap-api-key

# Turso cloud SQLite (persistent DB across Render redeploys)
TURSO_URL=libsql://smartwear-YOUR_USERNAME.turso.io
TURSO_TOKEN=your-turso-auth-token
